# Google Analytics 4 Measurement ID (Admin → Data streams → Web → Measurement ID).
# Set the same variable in Netlify Site settings → Environment variables
# (or Cloudflare Workers/Pages env) so production builds include tracking.
# Leave empty locally if you do not want to record your own visits.
# Dashboard (not linked in the site menu): https://analytics.google.com
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
